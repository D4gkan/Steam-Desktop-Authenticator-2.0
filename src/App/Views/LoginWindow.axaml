<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SteamDesktopAuthenticator.Views.LoginWindow"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPanelBrush}"
        Title="Steam Login">
  <Border Padding="24" CornerRadius="12">
    <StackPanel Spacing="16">
      <TextBlock Classes="h1" Text="Steam Login"/>
      <TextBlock x:Name="ExplanationText" Classes="muted" TextWrapping="Wrap"/>

      <StackPanel Spacing="6">
        <TextBlock Classes="muted" Text="Username"/>
        <TextBox x:Name="UsernameBox"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="muted" Text="Password"/>
        <TextBox x:Name="PasswordBox" PasswordChar="•"/>
      </StackPanel>

      <StackPanel Spacing="2">
        <CheckBox x:Name="SavePasswordCheckBox" Content="Save password for automatic re-login"/>
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,0"
                   Text="Stored in this system's secure credential store (Windows Credential Manager, macOS Keychain, or the Linux Secret Service) - not in a plain file. Used only to sign back in automatically when your session expires."/>
      </StackPanel>

      <TextBlock x:Name="StatusText" Classes="muted" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="False"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="secondary" Content="Cancel" Click="OnCancelClick"/>
        <Button x:Name="LoginButton" Classes="primary" Content="Login" Click="OnLoginClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
