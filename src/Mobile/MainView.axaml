<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Sda.Mobile" x:Class="Sda.Mobile.MainView" x:DataType="local:MainViewModel" RenderOptions.TextRenderingMode="Antialias" TopLevel.AutoSafeAreaPadding="True">
  <UserControl.Background>
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#171025" Offset="0" />
      <GradientStop Color="#09090F" Offset="0.45" />
      <GradientStop Color="#050508" Offset="1" />
    </LinearGradientBrush>
  </UserControl.Background>
  <Grid Margin="20,12,20,8">
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsUnlocked}">
      <Grid ColumnDefinitions="*,44,44" Margin="0,0,0,20">
        <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold" LetterSpacing="-0.6" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon quiet" Click="OnRefresh" IsVisible="{Binding ShowActivity}" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="Refresh confirmations">
          <Path Width="20" Height="20" Stretch="Uniform" Stroke="#AC9CCB" StrokeThickness="1.5" Data="M18,8 A8,8 0 1 0 18,14 M18,2 L18,8 L12,8" />
        </Button>
        <Button Grid.Column="2" Classes="icon quiet" Click="OnSettingsTab" AutomationProperties.Name="Settings">
          <Path Width="20" Height="20" Stretch="Uniform" Stroke="#AC9CCB" StrokeThickness="1.5" Data="M8,1 L12,1 L13,4 L16,5 L19,5 L21,9 L19,12 L19,15 L17,18 L14,18 L12,21 L8,21 L7,18 L4,17 L1,17 L-1,13 L1,10 L1,7 L3,4 L6,4 Z M10,7 A4,4 0 1 0 10,15 A4,4 0 1 0 10,7" />
        </Button>
      </Grid>
      <RefreshContainer Grid.Row="1" RefreshRequested="OnPullRefresh">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="20" Margin="0,0,0,88">
            <Border Classes="card" Padding="14,6" IsVisible="{Binding ShowNotice}">
              <Grid ColumnDefinitions="*,36" RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding Status}" IsVisible="{Binding !IsBusy}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Margin="0,6,8,6" />
                <TextBlock Text="{Binding BusyMessage}" IsVisible="{Binding IsBusy}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Margin="0,6,8,6" />
                <Button Grid.Column="1" Classes="quiet" MinHeight="36" Padding="6" Content="×" Click="OnDismissNotice" IsVisible="{Binding !IsBusy}" AutomationProperties.Name="Dismiss message" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Height="2" Margin="0,4,0,6" IsVisible="{Binding IsBusy}" />
              </Grid>
            </Border>
            <StackPanel Spacing="20">
              <StackPanel Spacing="16" IsVisible="{Binding ShowAccounts}">
                <Border Classes="card" IsVisible="{Binding HasNoAccounts}" Padding="20,36">
                  <StackPanel Spacing="20">
                    <TextBlock Text="No accounts yet" FontSize="19" HorizontalAlignment="Center" />
                    <Button Content="Paste account data" Classes="quiet accent" Click="OnPaste" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Accounts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:MobileAccount">
                      <Border Classes="card" Padding="14" Margin="0,0,0,12" MinHeight="96">
                        <Grid ColumnDefinitions="40,*,44,44" ColumnSpacing="4">
                          <Border Width="40" Height="40" CornerRadius="20" Background="#2A203B" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Medium" Foreground="#C2ABEA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Classes="quiet" Click="OnCopy" Tag="{Binding}" Padding="0" MinHeight="24" HorizontalContentAlignment="Left">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Grid.Row="1" Classes="code" Click="OnCopy" Tag="{Binding}" MinHeight="32" AutomationProperties.Name="Copy Steam Guard code">
                              <TextBlock Text="{Binding Code}" FontSize="25" LetterSpacing="3" FontWeight="Medium" Foreground="#C7B3E5" />
                            </Button>
                          </Grid>
                          <local:CountdownRing Grid.Column="2" Width="28" Height="28" Seconds="{Binding SecondsRemaining}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                          <Button Grid.Column="3" Classes="quiet" Click="OnManageAccount" Tag="{Binding}" Width="44" Height="44" MinHeight="44" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="Account options" IsEnabled="{Binding $parent[UserControl].((local:MainViewModel)DataContext).CanInteract}">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center"><Ellipse Width="3" Height="3" Fill="#ADA0C2" /><Ellipse Width="3" Height="3" Fill="#ADA0C2" /><Ellipse Width="3" Height="3" Fill="#ADA0C2" /></StackPanel>
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Export backup" Click="OnMenuExport"><MenuItem.Icon><Path Width="16" Height="18" Stroke="#AC9CCB" StrokeThickness="1.5" Stretch="Uniform" Data="M9,1 L9,13 M4,6 L9,1 L14,6 M1,12 L1,18 L17,18 L17,12" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Show transfer QR" Click="OnMenuQr"><MenuItem.Icon><Path Width="17" Height="17" Stroke="#AC9CCB" StrokeThickness="1.5" Stretch="Uniform" Data="M1,1 L7,1 L7,7 L1,7 Z M12,1 L18,1 L18,7 L12,7 Z M1,12 L7,12 L7,18 L1,18 Z M12,12 L18,12 L18,18 L12,18 Z" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Sign in" Click="OnMenuSignIn"><MenuItem.Icon><Path Width="17" Height="17" Stroke="#AC9CCB" StrokeThickness="1.5" Stretch="Uniform" Data="M1,9 L13,9 M8,4 L13,9 L8,14 M6,2 L18,2 L18,16 L6,16" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Finish linking" Click="OnMenuResume" IsVisible="{Binding IsPending}"><MenuItem.Icon><Path Width="17" Height="17" Stroke="#AC9CCB" StrokeThickness="1.5" Stretch="Uniform" Data="M3,9 L7,13 L15,4" /></MenuItem.Icon></MenuItem>
                                <Separator />
                                <MenuItem Header="Remove account" Classes="danger" Click="OnMenuRemove"><MenuItem.Icon><Path Width="16" Height="18" Stroke="#C3A1B1" StrokeThickness="1.5" Stretch="Uniform" Data="M2,4 L16,4 M5,4 L5,16 L13,16 L13,4 M7,1 L11,1 L12,4 M8,7 L8,13 M10,7 L10,13" /></MenuItem.Icon></MenuItem>
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="16" IsVisible="{Binding ShowActivity}">
                <ItemsControl ItemsSource="{Binding ConfirmationIssues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ConfirmationIssue">
                      <Border Classes="card" Padding="16" Margin="0,0,0,12">
                        <StackPanel Spacing="10">
                          <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" Foreground="#C3A1B1" />
                          <Button Content="Sign in" Classes="quiet accent" Click="OnConfirmationSignIn" Tag="{Binding}" HorizontalAlignment="Left" Padding="0" IsVisible="{Binding CanSignIn}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="card" Padding="20,36" IsVisible="{Binding HasNoConfirmations}">
                  <TextBlock Text="No confirmations" FontSize="18" HorizontalAlignment="Center" />
                </Border>
                <ItemsControl ItemsSource="{Binding Confirmations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:MobileConfirmation">
                      <Border Classes="card" Margin="0,0,0,12" Padding="18">
                        <StackPanel Spacing="16">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding AccountName}" FontSize="13" FontWeight="Medium" Foreground="#B7A2D6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#9995A7" FontSize="13" VerticalAlignment="Center" />
                          </Grid>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Description}" Foreground="#B0AABB" FontSize="14" TextWrapping="Wrap" />
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding $parent[UserControl].((local:MainViewModel)DataContext).CanInteract}">
                            <Button Classes="confirm-action confirm-reject" Click="OnReject" Tag="{Binding}" HorizontalAlignment="Stretch" AutomationProperties.Name="Reject confirmation">
                              <Grid ColumnDefinitions="18,70" ColumnSpacing="8"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" VerticalAlignment="Center" Data="M9,1 A8,8 0 1 1 8.99,1 M6,6 L12,12 M12,6 L6,12" /><TextBlock Grid.Column="1" Text="Reject" FontSize="13" FontWeight="Medium" Foreground="{Binding $parent[Button].Foreground}" TextAlignment="Center" VerticalAlignment="Center" /></Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="confirm-action confirm-approve" Click="OnApprove" Tag="{Binding}" HorizontalAlignment="Stretch" AutomationProperties.Name="Approve confirmation">
                              <Grid ColumnDefinitions="18,70" ColumnSpacing="8"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" VerticalAlignment="Center" Data="M9,1 A8,8 0 1 1 8.99,1 M5,9 L8,12 L13,6" /><TextBlock Grid.Column="1" Text="Approve" FontSize="13" FontWeight="Medium" Foreground="{Binding $parent[Button].Foreground}" TextAlignment="Center" VerticalAlignment="Center" /></Grid>
                            </Button>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="24" IsVisible="{Binding ShowSettings}" IsEnabled="{Binding CanInteract}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Security" Classes="section" />
                  <Border Classes="card" Padding="0">
                    <StackPanel>
                      <Button Classes="setting" Click="OnChangePasscode" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,20">
                          <TextBlock Text="Change passcode" />
                          <TextBlock Grid.Column="1" Text="›" HorizontalAlignment="Right" Foreground="#8F849F" />
                        </Grid>
                      </Button>
                      <Border Classes="divider" />
                      <Button Content="Lock app" Classes="setting" Click="OnLock" HorizontalAlignment="Stretch" />
                      <Border Classes="divider" />
                      <Grid ColumnDefinitions="*,Auto" Margin="18,16">
                        <TextBlock Text="Auto-lock" />
                        <TextBlock Grid.Column="1" Text="15 minutes" Foreground="#9995A7" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </RefreshContainer>
      <Button Grid.Row="1" Width="56" Height="56" MinHeight="56" CornerRadius="17" FontSize="30" Content="+" Classes="primary" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,20" IsVisible="{Binding ShowAccounts}" AutomationProperties.Name="Add account" IsEnabled="{Binding CanInteract}">
        <Button.Flyout>
          <MenuFlyout Placement="TopEdgeAlignedRight">
            <MenuItem Header="Import file" Click="OnImport" />
            <MenuItem Header="Scan QR" Click="OnScan" />
            <MenuItem Header="Paste account data" Click="OnPaste" />
            <MenuItem Header="Link authenticator" Click="OnLink" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Border Grid.Row="2" BorderBrush="#272330" BorderThickness="0,1,0,0" Padding="0,8,0,0">
        <Grid ColumnDefinitions="*,*" IsEnabled="{Binding IsUnlocked}">
          <Button Classes="nav" Classes.active="{Binding ShowAccounts}" Click="OnAccountsTab" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
              <Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Data="M1,1 L8,1 L8,8 L1,8 Z M12,1 L19,1 L19,8 L12,8 Z M1,12 L8,12 L8,19 L1,19 Z M12,12 L19,12 L19,19 L12,19 Z" HorizontalAlignment="Center" />
              <TextBlock Text="Accounts" FontSize="11" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="nav" Classes.active="{Binding ShowActivity}" Click="OnActivityTab" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
              <Grid Width="40" Height="20">
                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Data="M10,1 A9,9 0 1 1 9.99,1 M5,10 L9,14 L15,7" HorizontalAlignment="Center" />
                <Border Background="#6855BD" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-4,0" IsVisible="{Binding HasPendingBadge}">
                  <TextBlock Text="{Binding PendingBadgeText}" FontSize="9" Foreground="#F0EDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <TextBlock Text="Confirmations" FontSize="11" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
    <StackPanel IsVisible="{Binding !IsUnlocked}" VerticalAlignment="Center" Spacing="28">
      <Image x:Name="StartupLogo" Source="avares://Sda.Mobile/Assets/AppLogo.png" Width="128" Height="128" HorizontalAlignment="Center" Stretch="Uniform">
        <Image.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.25" /></Transitions></Image.Transitions>
      </Image>
      <StackPanel Spacing="16" IsVisible="{Binding IsError}">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#C6A0B0" />
        <Button Content="Try again" Classes="quiet accent" Click="OnUnlock" HorizontalAlignment="Center" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </StackPanel>
    <Border Background="#09090F" IsVisible="{Binding HasQr}">
      <StackPanel VerticalAlignment="Center" Spacing="24">
        <TextBlock Text="Account transfer" FontSize="24" FontWeight="SemiBold" />
        <Border Background="White" Padding="16" CornerRadius="16">
          <Image Source="{Binding QrImage}" MaxHeight="320" Stretch="Uniform" />
        </Border>
        <Button Content="Close" Click="OnCloseQr" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
    <Border x:Name="PromptOverlay" Background="#09090F" IsVisible="False">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" Spacing="20" Margin="0,24">
          <TextBlock x:Name="PromptTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="PromptMessage" Foreground="#B0AABB" TextWrapping="Wrap" />
          <TextBox x:Name="PromptInput" Watermark="Enter here" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Content="Cancel" Click="OnPromptCancel" HorizontalAlignment="Stretch" />
            <Button x:Name="PromptContinue" Grid.Column="1" Content="Continue" Classes="primary" Click="OnPromptContinue" HorizontalAlignment="Stretch" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border x:Name="PinOverlay" Background="#09090F" Margin="-20,-12,-20,-8" Padding="24,12,24,8" IsVisible="False" Focusable="True" KeyDown="OnPinKeyDown">
      <Grid RowDefinitions="44,*,Auto">
        <Button x:Name="PinCancel" Content="Cancel" Classes="quiet" Click="OnPromptCancel" HorizontalAlignment="Left" Padding="0" />
        <StackPanel Grid.Row="1" Spacing="28" VerticalAlignment="Center">
          <TextBlock x:Name="PinTitle" Text="Enter passcode" FontSize="24" FontWeight="Medium" HorizontalAlignment="Center" />
          <UniformGrid x:Name="PinSlots" Rows="1" Columns="6" Height="52" />
          <TextBlock x:Name="PinError" TextAlignment="Center" TextWrapping="Wrap" Foreground="#C6A0B0" FontSize="13" />
          <Button x:Name="LegacyPinToggle" Content="Use 8 digits" Classes="quiet accent" Click="OnLegacyPinToggle" HorizontalAlignment="Center" IsVisible="False" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" RowDefinitions="64,64,64,64" ColumnSpacing="12" RowSpacing="8" Margin="12,20,12,32">
          <Button Content="1" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Content="2" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Column="2" Content="3" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Content="4" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Grid.Column="1" Content="5" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Grid.Column="2" Content="6" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="2" Content="7" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="2" Grid.Column="1" Content="8" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="2" Grid.Column="2" Content="9" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="3" Grid.Column="1" Content="0" Classes="key" Click="OnPinDigit" HorizontalAlignment="Stretch" />
          <Button Grid.Row="3" Grid.Column="2" Content="⌫" Classes="key quiet" Click="OnPinDelete" HorizontalAlignment="Stretch" AutomationProperties.Name="Delete digit" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
